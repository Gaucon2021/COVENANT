{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://covenant-dun.vercel.app; script-src 'self'; object-src 'none'; base-uri 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*).json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://covenant-dun.vercel.app"
        },
        {
          "key": "Vary",
          "value": "Origin"
        }
      ]
    }
  ]
}